<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aicoding.infra.mapper.UserInfoMapper">
    <resultMap id="BaseResultMap" type="com.example.aicoding.infra.po.UserInfoPO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="age" property="age" jdbcType="INTEGER"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT id, name, age FROM user_info WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT id, name, age FROM user_info ORDER BY id
    </select>

    <insert id="insert" parameterType="com.example.aicoding.infra.po.UserInfoPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_info (name, age) VALUES (#{name}, #{age})
    </insert>

    <update id="update" parameterType="com.example.aicoding.infra.po.UserInfoPO">
        UPDATE user_info SET name = #{name}, age = #{age} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM user_info WHERE id = #{id}
    </delete>
</mapper>
